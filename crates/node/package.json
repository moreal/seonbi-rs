{
  "name": "@seonbi/node",
  "version": "0.1.0",
  "description": "Node.js bindings for seonbi-rs",
  "license": "LGPL-2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/moreal/seonbi-rs"
  },
  "homepage": "https://github.com/moreal/seonbi-rs",
  "bugs": {
    "url": "https://github.com/moreal/seonbi-rs/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "npm"
  ],
  "napi": {
    "binaryName": "seonbi",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node --test __tests__/index.spec.mjs",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "optionalDependencies": {
    "@seonbi/node-darwin-arm64": "0.1.0",
    "@seonbi/node-darwin-x64": "0.1.0",
    "@seonbi/node-linux-arm64-gnu": "0.1.0",
    "@seonbi/node-linux-x64-gnu": "0.1.0",
    "@seonbi/node-linux-x64-musl": "0.1.0",
    "@seonbi/node-win32-x64-msvc": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
