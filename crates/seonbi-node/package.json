{
  "name": "@seonbi/seonbi",
  "version": "0.1.0",
  "description": "Node.js bindings for seonbi-rs",
  "license": "LGPL-2.1",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "npm"
  ],
  "napi": {
    "name": "seonbi",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node --test __tests__/index.spec.mjs",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "optionalDependencies": {
    "@seonbi/seonbi-darwin-arm64": "0.1.0",
    "@seonbi/seonbi-darwin-x64": "0.1.0",
    "@seonbi/seonbi-linux-arm64-gnu": "0.1.0",
    "@seonbi/seonbi-linux-x64-gnu": "0.1.0",
    "@seonbi/seonbi-linux-x64-musl": "0.1.0",
    "@seonbi/seonbi-win32-x64-msvc": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
