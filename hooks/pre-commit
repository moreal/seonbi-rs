#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] cargo build"
cargo build

echo "[pre-commit] cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "[pre-commit] cargo clippy --workspace --all-targets"
cargo clippy --workspace --all-targets

echo "[pre-commit] actionlint"
mise exec -- actionlint

echo "[pre-commit] all checks passed"
